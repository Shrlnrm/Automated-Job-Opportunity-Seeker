# Required environment variables for AJOS
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Google Places API key (for company search)
PLACES_API_KEY=

# OpenRouter API key (for AI email drafts)
OPENROUTER_API_KEY=

# Server port (Vercel ignores this; used locally only)
PORT=3000

# SerpAPI key (for job search via Google Jobs engine)
SERP_API_KEY=

# Brave Search API key (reserved, not currently used in production routes)
BRAVE_SEARCH_API_KEY=

# Cloudflare Turnstile secret key (for bot verification on auth forms)
TURNSTILE_SECRET_KEY=

# Firebase Admin SDK credentials
# Option A (local dev): path to the service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/ajos-firebase-adminsdk.json
# Option B (Vercel/production): paste the entire JSON content as a single-line string
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Maximum SerpAPI calls per day across all users (circuit breaker)
SERP_DAILY_CAP=15

# Set to 'production' on Vercel; 'development' locally
NODE_ENV=production

# Exact origin URL of the deployed app (used for strict CORS in production)
# Example: https://automated-job-opportunity-seeker.vercel.app
ALLOWED_ORIGIN=

# Admin / Owner account email (unrestricted developer access)
OWNER_EMAIL=
